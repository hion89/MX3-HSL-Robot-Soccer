# ============================================================================
#  정책 출력/입력 관절 순서 — Isaac MX_LEG_JOINTS 와 동일(preserve_order=True).
#  이 순서가 학습과 어긋나면 좌/우가 뒤바뀌어 즉시 발산하므로 절대 바꾸지 말 것.
# ============================================================================
POLICY_JOINTS = [
    "r_pelvis_pitch_joint",
    "r_pelvis_roll_joint",
    "r_pelvis_yaw_joint",
    "r_knee_pitch_joint",
    "r_ankle_pitch_joint",
