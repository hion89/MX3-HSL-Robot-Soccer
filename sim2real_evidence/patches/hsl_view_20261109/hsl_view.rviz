Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: HalfMetreGrid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Color: 65; 85; 65
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: HSL_Field_Robot_Ball
      Enabled: true
      Topic:
        Value: /hsl/view/markers
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF_optional
      Enabled: false
      Marker Scale: 0.25
      Show Names: true
      Value: false
  Global Options:
    Fixed Frame: map
    Frame Rate: 10
    Background Color: 20; 45; 25
  Enabled: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 160
      X: 0
      Y: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Width: 1200
  Height: 850
  X: 30
  Y: 30
