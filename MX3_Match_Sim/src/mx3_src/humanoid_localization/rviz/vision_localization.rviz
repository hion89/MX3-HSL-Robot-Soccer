        r_pelvis_roll_link:
          Value: true
        r_pelvis_yaw_link:
          Value: true
        r_shoulder_pitch_link:
          Value: true
        r_shoulder_roll_link:
          Value: true
      Marker Scale: 0.4000000059604645
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            base_link:
