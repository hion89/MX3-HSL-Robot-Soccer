Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /VisionDebug1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 160; 160; 160
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: FieldLines
      Enabled: true
      Topic:
        Value: /field_markers
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: VisionDebug
      Enabled: true
      Topic:
        Value: /localization/vision_debug
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: VisionPose
      Enabled: true
      Topic:
        Value: /localization/vision_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 25; 0
      Covariance:
        Position:
          Color: 204; 51; 204
          Scale: 1
        Value: true
      Axes Length: 0.3
      Axes Radius: 0.02
      Shape: Axes
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: EKF Filtered
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Covariance:
        Value: false
      Shape: Arrow
      Color: 25; 255; 0
      Alpha: 1
      Shaft Length: 0.45
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.09
      Keep: 1
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Detections
      Enabled: true
      Topic:
        Value: /perception/annotated_3d
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Name: 2D Pose Estimate
      Topic:
        Value: /initialpose
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 3.14
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  Detections:
    collapsed: false
