  <!-- ============================================================ -->
  <!-- D405 카메라 부착 (neck_pitch_link 앞면에 고정)                -->
  <!--                                                              -->
  <!-- camera_link : RealSense 드라이버가 이 link 아래로                -->
  <!--   camera_color_optical_frame 등을 자동 부착한다.                -->
  <!--   따라서 이 fixed joint 하나만 추가하면 로봇 TF tree 와            -->
  <!--   카메라 TF tree 가 하나로 연결된다.                            -->
  <!--                                                              -->
  <!-- origin xyz : neck_pitch_link 원점 기준 camera_link 까지의 실측 오프셋  -->
  <!--   X = +0.045 m (앞으로 45mm), Z = +0.020 m (위로 20mm), Y = 0        -->
  <!--   ※ 더 정확히 하려면 D405 datasheet 의 mounting hole → left imager   -->
  <!--     오프셋까지 반영할 것. 현재는 케이스 외형 기준 실측 근사값.          -->
  <!-- origin rpy : 카메라가 neck_pitch_link 와 같은 방향(정면)을 본다고 가정.  -->
  <!--   카메라가 기울여 장착됐다면 이 rpy 를 수정해야 함.                  -->
  <!-- ============================================================ -->
  <link name="camera_link" />
  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="0.045 0 0.020" rpy="0 0 0" />
    <parent link="neck_pitch_link" />
    <child link="camera_link" />
  </joint>
</robot>